# ==============================================================================
# BUILD.FUNC — TWO-ROOT ENTRY POINT
# ==============================================================================
# The engine (this repo, community-scripts/core) and the scripts (ProxmoxVE,
# ProxmoxVED, Incus) live in SEPARATE repositories, so a single origin can no
# longer address both. Everything below distinguishes two roots:
#
#   ENGINE  — shared/ pve/ incus/     → core
#   SCRIPTS — ct/ install/ vm/        → whichever script repo invoked us
#
# Each root resolves independently, so a fork/branch of core can be tested
# against production scripts and vice versa:
#
#   COMMUNITY_SCRIPTS_CORE_URL / COMMUNITY_SCRIPTS_CORE_DIR   → engine
#   COMMUNITY_SCRIPTS_URL      / COMMUNITY_SCRIPTS_ROOT       → scripts
#
# Paths are folder-qualified: "shared/core.func", "pve/backend.func",
# "incus/build.func" for the engine, "ct/…" and "install/…" for the scripts.
# ==============================================================================

[[ -n "${_LXC_BUILD_DISPATCHED:-}" ]] && return
_LXC_BUILD_DISPATCHED=1

_CS_DEFAULT_URL="${_CS_DEFAULT_URL:-https://raw.githubusercontent.com/community-scripts/ProxmoxVED/main}"
_CS_CORE_DEFAULT_URL="${_CS_CORE_DEFAULT_URL:-https://raw.githubusercontent.com/community-scripts/core/main}"

# ── Engine layout ─────────────────────────────────────────────────────────────
# Paths are folder-qualified ("incus/backend.func"), so the folder itself says
# which root a path belongs to and no name→folder map is needed. That is also
# what lets the files drop their platform prefix: incus/build.func and
# shared/build.func can coexist because nothing resolves by basename.
_cs_is_engine_path() {
  case "${1:-}" in
  shared/* | pve/* | incus/*) return 0 ;;
  *) return 1 ;;
  esac
}

# ── Engine root ───────────────────────────────────────────────────────────────
# This file lives at <core>/shared/build.func, so the engine root is its parent.
if [[ -z "${COMMUNITY_SCRIPTS_CORE_DIR:-}" && -n "${BASH_SOURCE[0]:-}" && -f "${BASH_SOURCE[0]}" ]]; then
  _cs_this_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
  if [[ "${_cs_this_dir##*/}" == "shared" && -d "${_cs_this_dir}/../pve" ]]; then
    COMMUNITY_SCRIPTS_CORE_DIR="$(cd "${_cs_this_dir}/.." >/dev/null 2>&1 && pwd)"
  fi
  unset _cs_this_dir
fi

# Back-compat: callers that still set COMMUNITY_SCRIPTS_DIR meant the engine.
if [[ -z "${COMMUNITY_SCRIPTS_CORE_DIR:-}" && -n "${COMMUNITY_SCRIPTS_DIR:-}" ]]; then
  COMMUNITY_SCRIPTS_CORE_DIR="${COMMUNITY_SCRIPTS_DIR}"
fi
[[ -n "${COMMUNITY_SCRIPTS_CORE_DIR:-}" ]] && export COMMUNITY_SCRIPTS_CORE_DIR

# ── Scripts root ──────────────────────────────────────────────────────────────
# Derived from the CT script that invoked us, NOT from the engine location.
# Conflating the two is what silently broke local install/ lookups before.
if [[ -z "${COMMUNITY_SCRIPTS_ROOT:-}" ]]; then
  _cs_caller="${_CS_ENTRY_SCRIPT:-${BASH_SOURCE[-1]:-}}"
  if [[ -n "$_cs_caller" && -f "$_cs_caller" ]]; then
    _cs_caller_dir="$(cd "$(dirname "$_cs_caller")" >/dev/null 2>&1 && pwd)"
    # <repo>/ct/foo.sh → <repo>
    if [[ -d "${_cs_caller_dir}/../install" || -d "${_cs_caller_dir}/../ct" ]]; then
      COMMUNITY_SCRIPTS_ROOT="$(cd "${_cs_caller_dir}/.." >/dev/null 2>&1 && pwd)"
    fi
  fi
  unset _cs_caller _cs_caller_dir
fi
[[ -n "${COMMUNITY_SCRIPTS_ROOT:-}" ]] && export COMMUNITY_SCRIPTS_ROOT

# ── Origin detection (per root, independently) ────────────────────────────────
# A fork/branch of core and a fork/branch of the scripts resolve separately, so
# either can be tested against production of the other.
_cs_load_origin_helper() {
  local base="${COMMUNITY_SCRIPTS_CORE_DIR:-}"
  [[ -z "$base" ]] && return 1
  local helper="${base}/shared/source-origin.func"
  [[ -f "$helper" ]] || return 1
  # shellcheck disable=SC1090
  source "$helper"
}

if command -v git >/dev/null 2>&1 && _cs_load_origin_helper 2>/dev/null; then
  if [[ -z "${COMMUNITY_SCRIPTS_CORE_URL:-}" && -n "${COMMUNITY_SCRIPTS_CORE_DIR:-}" && -d "${COMMUNITY_SCRIPTS_CORE_DIR}/.git" ]]; then
    _cs_url="$(cs_detect_origin_from_git "$COMMUNITY_SCRIPTS_CORE_DIR" 2>/dev/null || true)"
    [[ -n "${_cs_url:-}" ]] && COMMUNITY_SCRIPTS_CORE_URL="$_cs_url"
    unset _cs_url
  fi
  if [[ -z "${COMMUNITY_SCRIPTS_URL:-}" && -n "${COMMUNITY_SCRIPTS_ROOT:-}" && -d "${COMMUNITY_SCRIPTS_ROOT}/.git" ]]; then
    _cs_url="$(cs_detect_origin_from_git "$COMMUNITY_SCRIPTS_ROOT" 2>/dev/null || true)"
    [[ -n "${_cs_url:-}" ]] && COMMUNITY_SCRIPTS_URL="$_cs_url"
    unset _cs_url
  fi
fi

COMMUNITY_SCRIPTS_URL="${COMMUNITY_SCRIPTS_URL:-$_CS_DEFAULT_URL}"
COMMUNITY_SCRIPTS_CORE_URL="${COMMUNITY_SCRIPTS_CORE_URL:-$_CS_CORE_DEFAULT_URL}"
export COMMUNITY_SCRIPTS_URL COMMUNITY_SCRIPTS_CORE_URL

# ── Resolution ────────────────────────────────────────────────────────────────
# Local file for a virtual path, or non-zero when it must be fetched remotely.
# Every branch is -f guarded: an unguarded assignment used to shadow the
# fallbacks and send existing files to the network.
_cs_local_path() {
  local rel="${1:?relative path}"
  local candidate

  if _cs_is_engine_path "$rel"; then
    [[ -z "${COMMUNITY_SCRIPTS_CORE_DIR:-}" ]] && return 1
    candidate="${COMMUNITY_SCRIPTS_CORE_DIR}/${rel}"
    if [[ -f "$candidate" ]]; then
      echo "$candidate"
      return 0
    fi
    return 1
  fi

  [[ -z "${COMMUNITY_SCRIPTS_ROOT:-}" ]] && return 1
  candidate="${COMMUNITY_SCRIPTS_ROOT}/${rel}"
  if [[ -f "$candidate" ]]; then
    echo "$candidate"
    return 0
  fi
  return 1
}

# Remote URL for a virtual path — engine and scripts use their own base.
_cs_remote_url() {
  local rel="${1:?relative path}"
  if _cs_is_engine_path "$rel"; then
    echo "${COMMUNITY_SCRIPTS_CORE_URL}/${rel}"
  else
    echo "${COMMUNITY_SCRIPTS_URL}/${rel}"
  fi
}

_cs_download() {
  local url="${1:?url}"
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url"
  else
    wget -qO- "$url"
  fi
}

# Fetch text: prefer a local checkout, else download from the matching base.
_cs_fetch_text() {
  local rel="${1:?relative path e.g. shared/install.func}"
  local file
  if file="$(_cs_local_path "$rel")" && [[ -n "$file" ]]; then
    cat "$file"
    return 0
  fi
  _cs_download "$(_cs_remote_url "$rel")"
}

_cs_source_func() {
  local rel="${1:?relative path}"
  local file
  if file="$(_cs_local_path "$rel")" && [[ -n "$file" ]]; then
    # shellcheck disable=SC1090
    source "$file"
    return 0
  fi
  # shellcheck disable=SC1090
  source <(_cs_download "$(_cs_remote_url "$rel")")
}

_cs_source_func "shared/lxc-platform.func"

if is_incus_lxc_backend; then
  _cs_source_func "incus/build.func"
  return 0
fi

_cs_source_func "shared/build-ui.func"
_cs_source_func "pve/backend.func"
