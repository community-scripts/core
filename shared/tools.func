#!/usr/bin/env bash
# ------------------------------------------------------------------------------
# Compatibility path -- the helper library loader moved to lib/tools.func.
#
# Scripts published before the move fetch this exact URL, and they keep running
# on other people's machines long after this repository was rearranged, so this
# path forwards instead of 404ing. Point new code at lib/tools.func.
#
# Sourced inline rather than through a function on purpose: `declare` inside a
# function is local, so a wrapper would quietly scope away every top-level
# declaration the forwarded file makes.
# ------------------------------------------------------------------------------

_CS_FWD="lib/tools.func"
_CS_FWD_BASE="${COMMUNITY_SCRIPTS_CORE_URL:-https://raw.githubusercontent.com/community-scripts/core/main}"

# A checkout entered through this old path still has to resolve locally, or a
# developer's edits would be silently ignored in favour of production.
_CS_FWD_DIR="${COMMUNITY_SCRIPTS_CORE_DIR:-}"
if [[ -z "${_CS_FWD_DIR}" && -n "${BASH_SOURCE[0]:-}" && -f "${BASH_SOURCE[0]}" ]]; then
  _CS_FWD_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." >/dev/null 2>&1 && pwd)"
fi

if [[ -n "${_CS_FWD_DIR}" && -s "${_CS_FWD_DIR}/${_CS_FWD}" ]]; then
  COMMUNITY_SCRIPTS_CORE_DIR="${_CS_FWD_DIR}"
  export COMMUNITY_SCRIPTS_CORE_DIR
  # shellcheck disable=SC1090
  source "${_CS_FWD_DIR}/${_CS_FWD}"
else
  # A failed download would otherwise source an empty stream and fail later,
  # somewhere unrelated. Fetch first, check, then source.
  if command -v curl >/dev/null 2>&1; then
    _CS_FWD_BODY="$(curl -fsSL "${_CS_FWD_BASE}/${_CS_FWD}")" || _CS_FWD_BODY=""
  else
    _CS_FWD_BODY="$(wget -qO- "${_CS_FWD_BASE}/${_CS_FWD}")" || _CS_FWD_BODY=""
  fi
  if [[ -z "${_CS_FWD_BODY}" ]]; then
    echo "FATAL: could not fetch ${_CS_FWD_BASE}/${_CS_FWD}" >&2
    exit 115
  fi
  # Process substitution, not a heredoc: a heredoc would take over stdin and
  # break every interactive prompt in the forwarded file.
  # shellcheck disable=SC1090
  source <(printf '%s
' "${_CS_FWD_BODY}")
  unset _CS_FWD_BODY
fi

unset _CS_FWD _CS_FWD_BASE _CS_FWD_DIR
