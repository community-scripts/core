# ==============================================================================
# INCUS/VM-CORE.FUNC - VIRTUAL MACHINE CREATION ON AN INCUS HOST
# ==============================================================================
# Counterpart to pve/vm-core.func. A VM script describes how the machine is
# built, and that is genuinely different per platform: Proxmox drives qm and
# imports a downloaded cloud image, Incus launches a VM image from a remote and
# configures it through native keys. So VM scripts are NOT shared between the
# two the way ct/ scripts are.
#
# Entry point: incus_vm_create <image> <name> <disk-size>
# ==============================================================================

[[ -n "${_INCUS_VM_CORE_LOADED:-}" ]] && return
_INCUS_VM_CORE_LOADED=1

_CORE_BASE="${COMMUNITY_SCRIPTS_CORE_URL:-https://raw.githubusercontent.com/community-scripts/core/main}"

# Repeated per file rather than shared: there is nowhere to put a shared copy
# that does not itself need downloading first. See core/build.func.
_CS_CURL_RETRY=(--retry 3 --retry-delay 1 --retry-connrefused --connect-timeout 10)

# Prefer the dispatcher's resolver so a local checkout and forks keep working.
_incus_vm_source() {
  local rel="$1"
  if declare -f _cs_source_func >/dev/null 2>&1; then
    _cs_source_func "$rel"
    return
  fi
  if [[ -n "${COMMUNITY_SCRIPTS_CORE_DIR:-}" && -f "${COMMUNITY_SCRIPTS_CORE_DIR}/${rel}" ]]; then
    # shellcheck disable=SC1090
    source "${COMMUNITY_SCRIPTS_CORE_DIR}/${rel}"
    return
  fi
  # shellcheck disable=SC1090
  source <(curl -fsSL "${_CS_CURL_RETRY[@]}" "${_CORE_BASE}/${rel}")
}

# core/core.func first: it owns prompt_confirm/prompt_input/prompt_select,
# which every prompt below needs and which incus/core.func does not provide.
_incus_vm_source "core/core.func"
# Value checks that do not depend on the platform — the Proxmox VE VM path
# loads the same file, so an MTU means the same thing on both.
_incus_vm_source "host/validate.func"
_incus_vm_source "incus/core.func"
load_incus_functions
incus_install_compat_aliases
incus_catch_errors

load_incus_vm_functions() {
  [[ -n "${__INCUS_VM_FUNCTIONS_LOADED:-}" ]] && return
  __INCUS_VM_FUNCTIONS_LOADED=1
  color
  formatting
  icons
  default_vars
  set_std_mode
}

load_functions() { load_incus_vm_functions; }

header_info() {
  # get_header derives the slug from APP and APP_TYPE itself.
  local header_content=""
  APP_TYPE="${APP_TYPE:-vm}"
  if declare -f get_header >/dev/null 2>&1; then
    header_content=$(get_header 2>/dev/null || true)
  fi
  _cs_clear
  if [[ -n "$header_content" ]]; then
    echo "$header_content"
  else
    echo -e "${INCUS_HEADER:-Incus VM :: ${APP:-Virtual Machine}}"
  fi
}

check_root() { incus_root_check; }
pve_check() { incus_check; }

arch_check() {
  # uname, not dpkg: an Incus host is not necessarily Debian-based.
  local arch
  arch="$(uname -m 2>/dev/null || echo unknown)"
  case "$arch" in
  x86_64 | amd64 | aarch64 | arm64) ;;
  *) fatal "Unsupported architecture for Incus VMs: $arch" ;;
  esac
}

# An Incus host without KVM can only run containers.
kvm_check() {
  if [[ ! -e /dev/kvm ]]; then
    fatal "No /dev/kvm on this host - Incus cannot run virtual machines here."
  fi
}

ssh_check() { :; }

exit_script() {
  _cs_clear
  echo -e "\n${CROSS}${RD}User exited script${CL}\n"
  exit 1
}

sanitize_vm_hostname() {
  local hostname="${1,,}"
  hostname=$(echo "$hostname" | tr -cs 'a-z0-9-' '-' | sed 's/^-//;s/-$//')
  echo "${hostname:0:63}"
}

# ==============================================================================
# SECTION 1: PROMPTS
# ==============================================================================
# Containers on Incus get whiptail through ui/build-ui.func; the VM path
# does not go through it and fell back to plain read prompts. Overriding the
# three primitives here lifts every vm_prompt_* below onto whiptail at once,
# with the text versions kept for non-TTY, missing whiptail, or VM_UI=text.

VM_BACKTITLE="Community Scripts :: Incus VM"

_vm_use_whiptail() {
  [[ "${VM_UI:-}" == "text" ]] && return 1
  command -v whiptail >/dev/null 2>&1 || return 1
  [[ -t 0 && -t 2 ]] || return 1
  declare -f is_unattended >/dev/null 2>&1 && is_unattended && return 1
  return 0
}

if _vm_use_whiptail; then
  _vm_text_prompt_confirm() { :; }

  prompt_confirm() {
    local message="${1:-Confirm?}" default="${2:-n}"
    local defno=()
    [[ "${default,,}" != "y" ]] && defno=(--defaultno)
    whiptail --backtitle "$VM_BACKTITLE" --title "${APP:-VM}"       "${defno[@]}" --yesno "$message" 10 68
  }

  prompt_input() {
    local message="${1:-Enter value:}" default="${2:-}" out
    out=$(whiptail --backtitle "$VM_BACKTITLE" --title "${APP:-VM}"       --inputbox "$message" 10 68 "$default" 3>&1 1>&2 2>&3) || {
      echo "$default"
      return 0
    }
    echo "${out:-$default}"
  }

  # Same contract as the text version: message, default index, timeout, then the
  # options; echoes the chosen option string.
  prompt_select() {
    local message="${1:-Select option:}" default="${2:-1}"
    shift 3
    local options=("$@") menu=() i=1 out
    ((${#options[@]} == 0)) && return 1
    for o in "${options[@]}"; do
      menu+=("$i" "$o")
      i=$((i + 1))
    done
    out=$(whiptail --backtitle "$VM_BACKTITLE" --title "${APP:-VM}"       --default-item "$default" --menu "$message" 16 68 "${#options[@]}"       "${menu[@]}" 3>&1 1>&2 2>&3) || {
      echo "${options[$((default - 1))]}"
      return 0
    }
    echo "${options[$((out - 1))]}"
  }
fi


vm_confirm_new_vm() {
  local message="${2:-Create new VM?}"
  prompt_confirm "$message" "y" 60
}

vm_choose_settings_mode() {
  prompt_confirm "Use Default Settings? (No = Advanced)" "y" 60
}

vm_confirm_advanced_settings() {
  prompt_confirm "${1:-Ready to create VM?}" "y" 120
}

vm_prompt_hostname() {
  local default_hostname="${1:-vm}" in
  in=$(prompt_input "Set Hostname" "$default_hostname" 60)
  HN=$(sanitize_vm_hostname "${in:-$default_hostname}")
  echo -e "${HOSTNAME}${BOLD}${DGN}Hostname: ${BGN}${HN}${CL}"
}

vm_prompt_cpu_cores() {
  local default_cores="${1:-2}"
  CORE_COUNT=$(prompt_input "Allocate CPU Cores" "$default_cores" 60)
  [[ "$CORE_COUNT" =~ ^[1-9][0-9]*$ ]] || CORE_COUNT="$default_cores"
  echo -e "${CPUCORE}${BOLD}${DGN}CPU Cores: ${BGN}${CORE_COUNT}${CL}"
}

vm_prompt_ram() {
  local default_ram="${1:-2048}"
  RAM_SIZE=$(prompt_input "Allocate RAM in MiB" "$default_ram" 60)
  [[ "$RAM_SIZE" =~ ^[1-9][0-9]*$ ]] || RAM_SIZE="$default_ram"
  echo -e "${RAMSIZE}${BOLD}${DGN}RAM Size: ${BGN}${RAM_SIZE}${CL}"
}

vm_prompt_disk_size() {
  local default_size="${1:-10G}" size
  size=$(prompt_input "Set Disk Size in GiB (e.g. 10 or 10G)" "$default_size" 60)
  size="${size// /}"
  [[ "$size" =~ ^[0-9]+$ ]] && size="${size}G"
  [[ "$size" =~ ^[0-9]+G$ ]] || size="$default_size"
  DISK_SIZE="$size"
  echo -e "${DISKSIZE}${BOLD}${DGN}Disk Size: ${BGN}${DISK_SIZE}${CL}"
}

vm_prompt_bridge() {
  local default_bridge="${1:-incusbr0}" networks
  networks=$(incus_get_networks 2>/dev/null | sed '/^\s*$/d')
  if [[ -n "$networks" ]] && ! grep -qx "$default_bridge" <<<"$networks"; then
    default_bridge=$(head -1 <<<"$networks")
  fi
  BRG=$(prompt_input "Set Network" "$default_bridge" 60)
  [[ -z "${BRG:-}" ]] && BRG="$default_bridge"
  echo -e "${BRIDGE}${BOLD}${DGN}Network: ${BGN}${BRG}${CL}"
}

vm_prompt_mac() {
  local input
  while true; do
    input=$(prompt_input "Set MAC Address (empty=auto)" "${1:-}" 60)
    validate_mac_address "$input" && break
    msg_warn "Use XX:XX:XX:XX:XX:XX (e.g. AA:BB:CC:DD:EE:FF), or empty to auto-generate."
  done
  MAC="$input"
  echo -e "${MACADDRESS}${BOLD}${DGN}MAC Address: ${BGN}${MAC:-auto}${CL}"
}

vm_prompt_vlan() {
  local input
  while true; do
    input=$(prompt_input "Set VLAN Tag (empty=none)" "${VLAN:-}" 60)
    validate_vlan_tag "$input" && break
    msg_warn "VLAN must be a number between 1 and 4094, or empty for none."
  done
  VLAN="$input"
  echo -e "${VLANTAG}${BOLD}${DGN}VLAN: ${BGN}${VLAN:-Default}${CL}"
}

vm_prompt_mtu() {
  local input
  while true; do
    input=$(prompt_input "Set Interface MTU (empty=default)" "${MTU:-}" 60)
    validate_mtu "$input" && break
    msg_warn "MTU must be a number between 576 and 65520, or empty for the default."
  done
  MTU="$input"
  echo -e "${DEFAULT}${BOLD}${DGN}Interface MTU: ${BGN}${MTU:-Default}${CL}"
}

vm_prompt_start_vm() {
  local default_start="${1:-yes}"
  if prompt_confirm "Start VM when completed?" "$([[ "$default_start" == "yes" ]] && echo y || echo n)" 60; then
    START_VM="yes"
  else
    START_VM="no"
  fi
  echo -e "${GATEWAY}${BOLD}${DGN}Start VM when completed: ${BGN}${START_VM}${CL}"
}

# Secure Boot is on by default for Incus VMs and stops images whose bootloader
# is not signed for it. Offer the escape hatch rather than let the VM hang.
vm_prompt_secureboot() {
  if prompt_confirm "Enable Secure Boot? (No is safer for most images)" "n" 60; then
    SECUREBOOT="yes"
  else
    SECUREBOOT="no"
  fi
  echo -e "${DEFAULT}${BOLD}${DGN}Secure Boot: ${BGN}${SECUREBOOT}${CL}"
}

vm_prompt_cloud_init() {
  local default_user="${1:-ubuntu}"
  if prompt_confirm "Enable Cloud-Init?" "n" 60; then
    USE_CLOUD_INIT="yes"
    CLOUDINIT_USER=$(prompt_input "Cloud-Init user" "$default_user" 60)
    CLOUDINIT_PASSWORD=$(prompt_input "Cloud-Init password (empty=SSH key only)" "" 60)
    CLOUDINIT_SSHKEY=$(prompt_input "SSH public key (empty=none)" "" 60)
    CLOUDINIT_NETWORK_MODE=$(prompt_select "Cloud-Init network mode" "1" 60 "dhcp" "static")
    if [[ "$CLOUDINIT_NETWORK_MODE" == "static" ]]; then
      CLOUDINIT_IP=$(prompt_input "Static IP/CIDR (e.g. 10.0.0.10/24)" "" 60)
      CLOUDINIT_GW=$(prompt_input "Gateway IPv4" "" 60)
      CLOUDINIT_DNS=$(prompt_input "DNS servers (space separated)" "1.1.1.1 8.8.8.8" 60)
    fi
  else
    USE_CLOUD_INIT="no"
  fi
  echo -e "${CLOUD}${BOLD}${DGN}Cloud-Init: ${BGN}${USE_CLOUD_INIT}${CL}"
}

vm_select_storage() {
  local pools first selected
  pools=$(incus_get_storage_pools | sed '/^\s*$/d')
  [[ -z "$pools" ]] && fatal "No Incus storage pools available"
  first=$(head -1 <<<"$pools")
  selected="$first"
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    if prompt_confirm "Use storage pool '$p'?" "$([[ "$p" == "$first" ]] && echo y || echo n)" 15; then
      selected="$p"
      break
    fi
  done <<<"$pools"
  STORAGE="$selected"
  echo -e "${DISKSIZE}${BOLD}${DGN}Storage: ${BGN}${STORAGE}${CL}"
}


# ── Storage / disk ────────────────────────────────────────────────────────────

# virtio-blk is the Incus default. virtio-scsi allows discard/TRIM passthrough,
# nvme is fastest on modern guests but needs a driver the guest actually has.
vm_prompt_disk_bus() {
  DISK_BUS=$(prompt_select "Disk bus" "1" 60 "virtio-blk" "virtio-scsi" "nvme")
  [[ -z "${DISK_BUS:-}" ]] && DISK_BUS="virtio-blk"
  echo -e "${DISKBUS}${BOLD}${DGN}Disk Bus: ${BGN}${DISK_BUS}${CL}"
}

vm_prompt_disk_cache() {
  DISK_CACHE=$(prompt_select "Disk cache mode" "1" 60 "none" "writeback" "unsafe")
  [[ -z "${DISK_CACHE:-}" ]] && DISK_CACHE="none"
  echo -e "${DISKSIZE}${BOLD}${DGN}Disk Cache: ${BGN}${DISK_CACHE}${CL}"
}

# A second disk is attached as a raw block device: without the agent running,
# Incus cannot mount it inside the guest for you.
vm_prompt_extra_disk() {
  EXTRA_DISK_SIZE=""
  if prompt_confirm "Attach a second disk?" "n" 60; then
    local size
    size=$(prompt_input "Extra disk size in GiB (e.g. 50)" "50" 60)
    size="${size// /}"
    [[ "$size" =~ ^[0-9]+G?$ ]] && EXTRA_DISK_SIZE="${size%G}"
  fi
  echo -e "${DISKSIZE}${BOLD}${DGN}Extra Disk: ${BGN}${EXTRA_DISK_SIZE:+${EXTRA_DISK_SIZE} GiB}${EXTRA_DISK_SIZE:-none}${CL}"
}

# ── Firmware ──────────────────────────────────────────────────────────────────

# CSM swaps UEFI for legacy BIOS. Needed by images with no EFI bootloader, and
# mutually exclusive with Secure Boot.
vm_prompt_csm() {
  if prompt_confirm "Use legacy BIOS instead of UEFI (CSM)?" "n" 60; then
    CSM="yes"
    SECUREBOOT="no"
  else
    CSM="no"
  fi
  echo -e "${OS}${BOLD}${DGN}Firmware: ${BGN}$([[ "$CSM" == "yes" ]] && echo "Legacy BIOS (CSM)" || echo "UEFI")${CL}"
}

# Windows 11 and anything doing measured boot needs a TPM 2.0 device.
vm_prompt_vtpm() {
  if prompt_confirm "Add a virtual TPM (needed for Windows 11)?" "n" 60; then
    VTPM="yes"
  else
    VTPM="no"
  fi
  echo -e "${VTPM_ICON:-${DEFAULT}}${BOLD}${DGN}Virtual TPM: ${BGN}${VTPM}${CL}"
}

# ── Hardware passthrough ──────────────────────────────────────────────────────

vm_prompt_gpu() {
  GPU_PASSTHROUGH="no"
  GPU_PCI=""
  if prompt_confirm "Pass through a GPU?" "n" 60; then
    GPU_PASSTHROUGH="yes"
    local gpus
    gpus=$(incus info --resources 2>/dev/null | awk '/PCI address:/ {print $NF}' | head -8)
    if [[ -n "$gpus" ]]; then
      GPU_PCI=$(prompt_input "GPU PCI address (empty = first available)" "" 60)
    fi
  fi
  echo -e "${GPU}${BOLD}${DGN}GPU Passthrough: ${BGN}${GPU_PASSTHROUGH}${GPU_PCI:+ (${GPU_PCI})}${CL}"
}

# Incus has a first-class usb device keyed on vendor/product id. Matching on a
# device path instead breaks the moment the guest or host renumbers it, which
# is exactly what happens across a replug or a reboot.
vm_prompt_usb() {
  USB_DEVICES=""
  local listing
  listing=$(incus info --resources 2>/dev/null |
    awk '/^ *USB devices:/,/^ *[A-Z][a-z]+ devices:/' |
    awk '/Vendor ID|Product ID|Vendor:|Product:/ {print}' | head -40)
  if prompt_confirm "Pass through USB devices?" "n" 60; then
    USB_DEVICES=$(prompt_input "vendorid:productid pairs, comma separated (e.g. 10c4:ea60)" "" 60)
  fi
  echo -e "${DEFAULT}${BOLD}${DGN}USB Passthrough: ${BGN}${USB_DEVICES:-none}${CL}"
}

# Raw PCI passthrough. Only meaningful for VMs, and only with the device bound
# to vfio-pci on the host -- otherwise the host is still using it.
vm_prompt_pci() {
  PCI_DEVICES=""
  if prompt_confirm "Pass through raw PCI devices (NIC, HBA, ...)?" "n" 60; then
    PCI_DEVICES=$(prompt_input "PCI addresses, comma separated (e.g. 0000:03:00.0)" "" 60)
  fi
  echo -e "${DEFAULT}${BOLD}${DGN}PCI Passthrough: ${BGN}${PCI_DEVICES:-none}${CL}"
}

# ── Shared storage ────────────────────────────────────────────────────────────

# A host directory handed straight to the guest. For a VM this rides on 9p or
# virtiofs and therefore needs the agent; for a container it is a plain bind
# mount.
vm_prompt_bind_mounts() {
  BIND_MOUNTS=""
  if prompt_confirm "Share a host directory with the VM?" "n" 60; then
    BIND_MOUNTS=$(prompt_input "host:guest pairs, comma separated (e.g. /srv/media:/media)" "" 60)
  fi
  echo -e "${DISKSIZE}${BOLD}${DGN}Shared folders: ${BGN}${BIND_MOUNTS:-none}${CL}"
}

# ── Port forwarding ───────────────────────────────────────────────────────────

vm_prompt_proxy() {
  PROXY_PORTS=""
  if prompt_confirm "Forward host ports into the VM?" "n" 60; then
    PROXY_PORTS=$(prompt_input "hostport:guestport pairs, comma separated (e.g. 8080:80)" "" 60)
  fi
  echo -e "${NETWORK}${BOLD}${DGN}Port forwards: ${BGN}${PROXY_PORTS:-none}${CL}"
}

# ── Lifecycle ─────────────────────────────────────────────────────────────────

vm_prompt_autostart() {
  if prompt_confirm "Start this VM automatically when the host boots?" "n" 60; then
    AUTOSTART="yes"
    AUTOSTART_ORDER=$(prompt_input "Boot priority (higher starts earlier)" "0" 60)
    [[ "$AUTOSTART_ORDER" =~ ^[0-9]+$ ]] || AUTOSTART_ORDER="0"
  else
    AUTOSTART="no"
  fi
  echo -e "${GATEWAY}${BOLD}${DGN}Autostart: ${BGN}${AUTOSTART}${CL}"
}

vm_prompt_snapshots() {
  SNAPSHOT_SCHEDULE=""
  if prompt_confirm "Enable automatic snapshots?" "n" 60; then
    SNAPSHOT_SCHEDULE=$(prompt_select "Snapshot schedule" "2" 60 "@hourly" "@daily" "@weekly")
    SNAPSHOT_EXPIRY=$(prompt_input "Keep snapshots for (e.g. 7d, 4w)" "7d" 60)
  fi
  echo -e "${SNAPSHOT}${BOLD}${DGN}Snapshots: ${BGN}${SNAPSHOT_SCHEDULE:-disabled}${CL}"
}

# ── Placement ─────────────────────────────────────────────────────────────────

vm_prompt_profiles() {
  PROFILES=""
  local available
  available=$(incus_get_profiles 2>/dev/null | tr '\n' ' ')
  if [[ -n "$available" ]] && prompt_confirm "Apply extra profiles? (available: ${available})" "n" 60; then
    PROFILES=$(prompt_input "Profile names, comma separated" "" 60)
  fi
  echo -e "${ADVANCED}${BOLD}${DGN}Profiles: ${BGN}${PROFILES:-default}${CL}"
}

# Only meaningful on a cluster; skipped silently on a standalone host.
vm_prompt_cluster_target() {
  CLUSTER_TARGET=""
  local members
  members=$(incus cluster list --format csv 2>/dev/null | cut -d, -f1 | sed '/^\s*$/d')
  if [[ -n "$members" ]]; then
    CLUSTER_TARGET=$(prompt_input "Cluster member (empty = automatic)" "" 60)
    echo -e "${NETWORK}${BOLD}${DGN}Cluster Target: ${BGN}${CLUSTER_TARGET:-auto}${CL}"
  fi
}

vm_prompt_description() {
  VM_DESCRIPTION=$(prompt_input "Description" "${APP:-VM} - community-scripts.org" 60)
  echo -e "${DEFAULT}${BOLD}${DGN}Description: ${BGN}${VM_DESCRIPTION}${CL}"
}

# ── Guest OS and agent ────────────────────────────────────────────────────────

# Incus changes real behaviour based on image.os: on Windows it disables
# unsupported virtual devices, bases the RTC on local time instead of UTC and
# switches to an Intel IOMMU; on FreeBSD it disables memory hotplug.
vm_prompt_guest_os() {
  GUEST_OS=$(prompt_select "Guest operating system" "1" 60 "Linux" "Windows" "macOS" "FreeBSD")
  [[ -z "${GUEST_OS:-}" ]] && GUEST_OS="Linux"
  # Windows 11 needs a TPM; offer it rather than let setup refuse to install.
  if [[ "$GUEST_OS" == "Windows" && "${VTPM:-no}" != "yes" ]]; then
    prompt_confirm "Windows detected - add a virtual TPM (required by Windows 11)?" "y" 60 &&
      VTPM="yes"
  fi
  echo -e "${OS}${BOLD}${DGN}Guest OS: ${BGN}${GUEST_OS}${CL}"
}

# The agent is what makes incus exec, file transfer and metrics work. Images
# from images: ship it; anything else needs the CD-ROM to install it from.
vm_prompt_agent_disk() {
  AGENT_DISK="no"
  if prompt_confirm "Attach the agent CD-ROM? (needed if the image has no incus-agent)" "n" 60; then
    AGENT_DISK="yes"
  fi
  echo -e "${DEFAULT}${BOLD}${DGN}Agent CD-ROM: ${BGN}${AGENT_DISK}${CL}"
}

# ── Sizing shortcut ───────────────────────────────────────────────────────────

# Incus accepts cloud instance types (t2.micro, aws:t2.micro, c1-m1) as a
# shorthand for cpu and memory limits.
vm_prompt_instance_type() {
  INSTANCE_TYPE=""
  if prompt_confirm "Size from a cloud instance type instead of cores/RAM?" "n" 60; then
    INSTANCE_TYPE=$(prompt_input "Instance type (e.g. t2.micro, c2-m4)" "c${CORE_COUNT:-2}-m$(((${RAM_SIZE:-2048} + 1023) / 1024))" 60)
  fi
  echo -e "${CPUCORE}${BOLD}${DGN}Instance Type: ${BGN}${INSTANCE_TYPE:-custom}${CL}"
}

# ── Resource limits ───────────────────────────────────────────────────────────
# CPU quota, swap and kernel modules are container-only in Incus and live on
# the container path; a VM is capped by its core count and its own kernel.




# Live migration and suspend both require transferable memory state.
vm_prompt_stateful() {
  if prompt_confirm "Enable stateful migration and suspend?" "n" 60; then
    STATEFUL="yes"
  else
    STATEFUL="no"
  fi
  echo -e "${NETWORK}${BOLD}${DGN}Stateful: ${BGN}${STATEFUL}${CL}"
}

# Deliberately a free-form field rather than twenty more prompts: raw.qemu,
# security.idmap.* and friends belong to people who already know what they do.
vm_prompt_extra_config() {
  EXTRA_CONFIG=""
  if prompt_confirm "Set additional raw config keys?" "n" 60; then
    EXTRA_CONFIG=$(prompt_input "key=value pairs, comma separated" "" 60)
  fi
  echo -e "${ADVANCED}${BOLD}${DGN}Extra config: ${BGN}${EXTRA_CONFIG:-none}${CL}"
}

# ── Protection ────────────────────────────────────────────────────────────────

vm_prompt_delete_protection() {
  if prompt_confirm "Protect this VM from accidental deletion?" "n" 60; then
    DELETE_PROTECTION="yes"
  else
    DELETE_PROTECTION="no"
  fi
  echo -e "${DEFAULT}${BOLD}${DGN}Delete Protection: ${BGN}${DELETE_PROTECTION}${CL}"
}

# ── Cloud-init vendor data ────────────────────────────────────────────────────

# vendor-data carries the general defaults, user-data the instance specifics.
# cloud-init merges them, so this is the place for a site-wide baseline.
vm_prompt_vendor_data() {
  CLOUDINIT_VENDOR_DATA=""
  [[ "${USE_CLOUD_INIT:-no}" != "yes" ]] && return 0
  if prompt_confirm "Add cloud-init vendor-data (site defaults)?" "n" 60; then
    local pkgs
    pkgs=$(prompt_input "Packages to install, space separated" "qemu-guest-agent" 60)
    local upgrade="false"
    prompt_confirm "Upgrade all packages on first boot?" "n" 60 && upgrade="true"
    CLOUDINIT_VENDOR_DATA="#cloud-config
package_upgrade: ${upgrade}"
    if [[ -n "$pkgs" ]]; then
      CLOUDINIT_VENDOR_DATA+="
packages:"
      local pkg
      for pkg in $pkgs; do CLOUDINIT_VENDOR_DATA+="
  - ${pkg}"; done
    fi
  fi
  echo -e "${CLOUD}${BOLD}${DGN}Vendor-Data: ${BGN}$([[ -n "$CLOUDINIT_VENDOR_DATA" ]] && echo configured || echo none)${CL}"
}

# ── Networking beyond the basics ──────────────────────────────────────────────

# A managed Incus network can hand out a fixed lease; this is not the same as
# configuring a static address inside the guest, which cloud-init does.
vm_prompt_static_lease() {
  NIC_IPV4=""
  if prompt_confirm "Reserve a fixed IPv4 on the managed network?" "n" 60; then
    NIC_IPV4=$(prompt_input "IPv4 address (must be inside the network subnet)" "" 60)
  fi
  echo -e "${NETWORK}${BOLD}${DGN}Fixed lease: ${BGN}${NIC_IPV4:-none}${CL}"
}


# ==============================================================================
# SECTION 2: VALIDATION
# ==============================================================================

# Not every image in a remote ships a virtual-machine variant; launching one
# that does not fails with a message nobody reads. Check first.
vm_check_image() {
  local image="${1:?image}"
  local remote="${image%%:*}" fingerprint="${image#*:}"
  [[ "$image" != *:* ]] && remote="local"

  msg_info "Checking image ${image} for a VM variant"
  if incus image list "${remote}:" type=virtual-machine --format csv -c l 2>/dev/null |
    tr ',' '\n' | grep -qx "$fingerprint"; then
    msg_ok "Image ${image} has a VM variant"
    return 0
  fi
  # Aliases are not always listed verbatim; fall back to asking about the image.
  if incus image info "$image" >/dev/null 2>&1; then
    msg_warn "Could not confirm a VM variant for ${image} - continuing"
    return 0
  fi
  fatal "Image ${image} not found. Try: incus image list images: type=virtual-machine"
}

# Returns a free instance name on stdout. The container path has picked the
# next free name since it was written; this one aborted instead, so a second
# debian VM on a host that already had a debian container was refused outright.
# incus_container_exists uses `incus info`, which covers VMs and containers
# alike, so the two paths cannot hand out the same name.
check_hostname_conflict() {
  local name="${1:-$HN}"
  incus_container_exists "$name" || {
    printf '%s' "$name"
    return 0
  }
  local alt
  alt="$(incus_get_next_name "$name")"
  msg_warn "Instance '${name}' already exists — using '${alt}'"
  printf '%s' "$alt"
}

# ==============================================================================
# SECTION 3: CREATION
# ==============================================================================

# fatal() signals via kill -INT $$, which is not guaranteed to stop execution in
# every environment, so every failure path below also returns explicitly rather
# than trusting it.

# Set by incus_vm_create so cleanup knows what to remove on failure.
_INCUS_VM_NAME=""
_INCUS_VM_CREATED=0

cleanup_vmid() {
  [[ "$_INCUS_VM_CREATED" -eq 1 && -n "$_INCUS_VM_NAME" ]] || return 0
  msg_warn "Removing partially created VM ${_INCUS_VM_NAME}"
  incus delete "$_INCUS_VM_NAME" --force >/dev/null 2>&1 || true
  _INCUS_VM_CREATED=0
}

cleanup() { cleanup_vmid; }

set_description() {
  [[ -z "${_INCUS_VM_NAME:-}" ]] && return 0
  incus config set "$_INCUS_VM_NAME" \
    user.description "${VM_DESCRIPTION:-${APP:-VM} - community-scripts.org}" >/dev/null 2>&1 || true
}

# Wait for the incus-agent inside the guest. Until it answers, incus exec fails
# and any post-install step would run against a machine that is not there yet.
vm_wait_for_agent() {
  local name="${1:?name}" timeout="${2:-180}" waited=0
  msg_info "Waiting for the guest agent (up to ${timeout}s)"
  while ((waited < timeout)); do
    if incus exec "$name" -- true >/dev/null 2>&1; then
      msg_ok "Guest agent is up"
      return 0
    fi
    sleep 3
    waited=$((waited + 3))
  done
  msg_warn "Guest agent did not respond within ${timeout}s - the VM is running, but incus exec is unavailable"
  return 1
}

vm_get_ip() {
  local name="${1:?name}" timeout="${2:-90}" waited=0 ip=""
  while ((waited < timeout)); do
    ip=$(incus list "$name" --format csv -c 4 2>/dev/null | tr ' ' '\n' | grep -oE '^[0-9.]+' | head -1)
    [[ -n "$ip" ]] && {
      echo "$ip"
      return 0
    }
    sleep 3
    waited=$((waited + 3))
  done
  return 1
}

_vm_cloud_init_user_data() {
  local user="${CLOUDINIT_USER:-ubuntu}"
  printf '#cloud-config\nhostname: %s\nmanage_etc_hosts: true\nusers:\n  - name: %s\n    sudo: ALL=(ALL) NOPASSWD:ALL\n    shell: /bin/bash\n    lock_passwd: false\n' \
    "${HN}" "$user"
  [[ -n "${CLOUDINIT_SSHKEY:-}" ]] &&
    printf '    ssh_authorized_keys:\n      - %s\n' "$CLOUDINIT_SSHKEY"
  if [[ -n "${CLOUDINIT_PASSWORD:-}" ]]; then
    printf 'chpasswd:\n  expire: false\n  list: |\n    %s:%s\nssh_pwauth: true\n' \
      "$user" "$CLOUDINIT_PASSWORD"
  fi
}

# cloud-init only works on an image that actually ships it. On the images:
# remote those are the /cloud variants -- images:debian/13 has no cloud-init at
# all, so the configuration would be set and silently ignored.
_vm_resolve_cloud_image() {
  local image="$1"
  [[ "${USE_CLOUD_INIT:-no}" != "yes" ]] && {
    echo "$image"
    return 0
  }
  [[ "$image" == */cloud ]] && {
    echo "$image"
    return 0
  }
  local candidate="${image}/cloud"
  if incus image info "$candidate" >/dev/null 2>&1; then
    msg_ok "Using the cloud-init variant ${candidate}"
    echo "$candidate"
    return 0
  fi
  msg_warn "No /cloud variant for ${image} - cloud-init may not run in this guest"
  echo "$image"
}

_vm_cloud_init_network_config() {
  local dns="${CLOUDINIT_DNS:-1.1.1.1 8.8.8.8}"
  printf 'version: 2\nethernets:\n  eth0:\n    dhcp4: false\n    addresses: [%s]\n    gateway4: %s\n    nameservers:\n      addresses: [%s]\n' \
    "$CLOUDINIT_IP" "$CLOUDINIT_GW" "${dns// /, }"
}

# incus_vm_create <image> <name> <disk-size>
#
# init -> configure -> start, in that order. Launching first and configuring
# afterwards means cloud-init lands after the guest has already booted, where
# it no longer does anything.
incus_vm_create() {
  local image="${1:-images:debian/13}"
  local vm_name="${2:-$HN}"
  local disk_size="${3:-${DISK_SIZE:-10G}}"
  local disk_gib="${disk_size%G}"

  [[ -z "$vm_name" ]] && { fatal "No VM name given"; return 1; }
  kvm_check
  image="$(_vm_resolve_cloud_image "$image")"
  vm_check_image "$image"
  vm_name="$(check_hostname_conflict "$vm_name")"
  HN="$vm_name"

  _INCUS_VM_NAME="$vm_name"

  local args=(--vm)
  args+=(--config "limits.cpu=${CORE_COUNT:-2}")
  args+=(--config "limits.memory=${RAM_SIZE:-2048}MiB")

  # CSM replaces UEFI with legacy BIOS and cannot coexist with Secure Boot.
  if [[ "${CSM:-no}" == "yes" ]]; then
    args+=(--config "security.csm=true")
    args+=(--config "security.secureboot=false")
  else
    args+=(--config "security.secureboot=$([[ "${SECUREBOOT:-no}" == "yes" ]] && echo true || echo false)")
  fi

  [[ "${AUTOSTART:-no}" == "yes" ]] && {
    args+=(--config "boot.autostart=true")
    args+=(--config "boot.autostart.priority=${AUTOSTART_ORDER:-0}")
  }
  [[ -n "${SNAPSHOT_SCHEDULE:-}" ]] && {
    args+=(--config "snapshots.schedule=${SNAPSHOT_SCHEDULE}")
    args+=(--config "snapshots.expiry=${SNAPSHOT_EXPIRY:-7d}")
  }

  args+=(--network "${BRG:-incusbr0}")
  args+=(--storage "${STORAGE:-default}")

  # Root disk: size plus the optional bus and cache overrides.
  local root_dev="root,size=${disk_gib}GiB"
  [[ -n "${DISK_BUS:-}" && "${DISK_BUS}" != "virtio-blk" ]] && root_dev+=",io.bus=${DISK_BUS}"
  [[ -n "${DISK_CACHE:-}" && "${DISK_CACHE}" != "none" ]] && root_dev+=",io.cache=${DISK_CACHE}"
  args+=(--device "$root_dev")

  # Profiles are additive; naming any at all replaces the implicit default.
  if [[ -n "${PROFILES:-}" ]]; then
    args+=(--profile default)
    local _p
    IFS=',' read -ra _profs <<<"$PROFILES"
    for _p in "${_profs[@]}"; do
      _p="${_p// /}"
      [[ -n "$_p" && "$_p" != "default" ]] && args+=(--profile "$_p")
    done
  fi

  [[ -n "${CLUSTER_TARGET:-}" ]] && args+=(--target "$CLUSTER_TARGET")
  [[ -n "${INSTANCE_TYPE:-}" ]] && args+=(--type "$INSTANCE_TYPE")

  # image.os is not cosmetic: Incus disables unsupported devices, changes the
  # RTC base and switches IOMMU handling based on it.
  case "${GUEST_OS:-Linux}" in
  Windows | macOS | FreeBSD) args+=(--config "image.os=${GUEST_OS}") ;;
  esac

  [[ "${DELETE_PROTECTION:-no}" == "yes" ]] &&
    args+=(--config "security.protection.delete=true")

  # Live migration and suspend-to-disk both need the memory state to be
  # transferable; without this Incus refuses either.
  [[ "${STATEFUL:-no}" == "yes" ]] && args+=(--config "migration.stateful=true")

  # limits.cpu.allowance, limits.cpu.priority, limits.memory.swap and
  # linux.kernel_modules are container-only per the host's own metadata.
  # Setting them on a VM is accepted silently and does nothing.
  [[ -n "${AUTOSTART_DELAY:-}" ]] && args+=(--config "boot.autostart.delay=${AUTOSTART_DELAY}")
  [[ -n "${SNAPSHOT_PATTERN:-}" ]] && args+=(--config "snapshots.pattern=${SNAPSHOT_PATTERN}")

  # Escape hatch: anything the prompts do not cover, as key=value pairs.
  if [[ -n "${EXTRA_CONFIG:-}" ]]; then
    local _kv
    IFS=',' read -ra _extra <<<"$EXTRA_CONFIG"
    for _kv in "${_extra[@]}"; do
      _kv="${_kv# }"
      [[ -n "$_kv" ]] && args+=(--config "$_kv")
    done
  fi

  msg_info "Creating VM ${vm_name} (${CORE_COUNT:-2} vCPU, ${RAM_SIZE:-2048} MiB, ${disk_gib} GiB)"
  if ! incus init "$image" "$vm_name" "${args[@]}" >/dev/null; then
    fatal "Failed to create VM ${vm_name}"
    return 1
  fi
  _INCUS_VM_CREATED=1
  msg_ok "Created VM ${vm_name}"

  # Everything below runs before first boot so the guest sees its final shape.
  _vm_set_nic() {
    local key="$1" value="$2" label="$3"
    [[ -z "$value" ]] && return 0
    incus config device set "$vm_name" eth0 "$key" "$value" >/dev/null 2>&1 ||
      msg_warn "Could not set ${label} (not supported on this network type)"
  }
  _vm_set_nic hwaddr "${MAC:-}" "MAC address"
  _vm_set_nic vlan "${VLAN:-}" "VLAN"
  _vm_set_nic mtu "${MTU:-}" "MTU"
  _vm_set_nic ipv4.address "${NIC_IPV4:-}" "fixed IPv4 lease"

  if [[ "${AGENT_DISK:-no}" == "yes" ]]; then
    incus config device add "$vm_name" agent disk source=agent:config >/dev/null 2>&1 &&
      msg_ok "Attached the agent CD-ROM (run install.sh inside the guest)" ||
      msg_warn "Could not attach the agent CD-ROM"
  fi

  if [[ "${VTPM:-no}" == "yes" ]]; then
    if incus config device add "$vm_name" vtpm tpm >/dev/null 2>&1; then
      msg_ok "Added virtual TPM"
    else
      msg_warn "Could not add a virtual TPM (needs swtpm on the host)"
    fi
  fi

  if [[ "${GPU_PASSTHROUGH:-no}" == "yes" ]]; then
    local gpu_args=(gpu)
    [[ -n "${GPU_PCI:-}" ]] && gpu_args+=("pci=${GPU_PCI}")
    if incus config device add "$vm_name" gpu0 "${gpu_args[@]}" >/dev/null 2>&1; then
      msg_ok "Added GPU passthrough${GPU_PCI:+ (${GPU_PCI})}"
    else
      msg_warn "Could not add the GPU - check 'incus info --resources'"
    fi
  fi

  if [[ -n "${EXTRA_DISK_SIZE:-}" ]]; then
    if incus config device add "$vm_name" data disk \
      pool="${STORAGE:-default}" size="${EXTRA_DISK_SIZE}GiB" >/dev/null 2>&1; then
      msg_ok "Attached a ${EXTRA_DISK_SIZE} GiB second disk (unformatted)"
    else
      msg_warn "Could not attach the second disk"
    fi
  fi

  # USB by vendor/product id, so a replug or renumbering does not break it.
  if [[ -n "${USB_DEVICES:-}" ]]; then
    local _u _i=0
    IFS=',' read -ra _usbs <<<"$USB_DEVICES"
    for _u in "${_usbs[@]}"; do
      _u="${_u// /}"
      [[ -z "$_u" ]] && continue
      local _vid="${_u%%:*}" _pid="${_u##*:}"
      if incus config device add "$vm_name" "usb${_i}" usb \
        vendorid="$_vid" productid="$_pid" >/dev/null 2>&1; then
        msg_ok "Passed through USB ${_u}"
      else
        msg_warn "Could not pass through USB ${_u}"
      fi
      _i=$((_i + 1))
    done
  fi

  # Raw PCI. Requires the device to be bound to vfio-pci on the host.
  if [[ -n "${PCI_DEVICES:-}" ]]; then
    local _p _i=0
    IFS=',' read -ra _pcis <<<"$PCI_DEVICES"
    for _p in "${_pcis[@]}"; do
      _p="${_p// /}"
      [[ -z "$_p" ]] && continue
      if incus config device add "$vm_name" "pci${_i}" pci address="$_p" >/dev/null 2>&1; then
        msg_ok "Passed through PCI ${_p}"
      else
        msg_warn "Could not pass through PCI ${_p} - is it bound to vfio-pci?"
      fi
      _i=$((_i + 1))
    done
  fi

  # Shared host directories. In a VM these ride on virtiofs/9p and only appear
  # once the agent is running.
  if [[ -n "${BIND_MOUNTS:-}" ]]; then
    local _m _i=0
    IFS=',' read -ra _mnts <<<"$BIND_MOUNTS"
    for _m in "${_mnts[@]}"; do
      _m="${_m// /}"
      [[ -z "$_m" ]] && continue
      local _src="${_m%%:*}" _dst="${_m##*:}"
      if incus config device add "$vm_name" "share${_i}" disk \
        source="$_src" path="$_dst" >/dev/null 2>&1; then
        msg_ok "Shared ${_src} at ${_dst}"
      else
        msg_warn "Could not share ${_src}"
      fi
      _i=$((_i + 1))
    done
  fi

  if [[ -n "${PROXY_PORTS:-}" ]]; then
    local _f _i=0
    IFS=',' read -ra _fwds <<<"$PROXY_PORTS"
    for _f in "${_fwds[@]}"; do
      _f="${_f// /}"
      [[ -z "$_f" ]] && continue
      local _hp="${_f%%:*}" _gp="${_f##*:}"
      if incus config device add "$vm_name" "proxy${_i}" proxy \
        listen="tcp:0.0.0.0:${_hp}" connect="tcp:127.0.0.1:${_gp}" >/dev/null 2>&1; then
        msg_ok "Forwarding host ${_hp} to guest ${_gp}"
      else
        msg_warn "Could not forward port ${_f}"
      fi
      _i=$((_i + 1))
    done
  fi

  if [[ "${USE_CLOUD_INIT:-no}" == "yes" ]]; then
    msg_info "Applying cloud-init configuration"
    local ud nc
    ud="$(_vm_cloud_init_user_data)"

    # Newer images read cloud-init.*, older ones user.*. Setting both costs
    # nothing and removes the guesswork about which an image supports.
    incus config set "$vm_name" cloud-init.user-data "$ud" >/dev/null
    incus config set "$vm_name" user.user-data "$ud" >/dev/null 2>&1 || true

    if [[ -n "${CLOUDINIT_VENDOR_DATA:-}" ]]; then
      incus config set "$vm_name" cloud-init.vendor-data "$CLOUDINIT_VENDOR_DATA" >/dev/null
      incus config set "$vm_name" user.vendor-data "$CLOUDINIT_VENDOR_DATA" >/dev/null 2>&1 || true
    fi

    if [[ "${CLOUDINIT_NETWORK_MODE:-dhcp}" == "static" && -n "${CLOUDINIT_IP:-}" && -n "${CLOUDINIT_GW:-}" ]]; then
      nc="$(_vm_cloud_init_network_config)"
      incus config set "$vm_name" cloud-init.network-config "$nc" >/dev/null
      incus config set "$vm_name" user.network-config "$nc" >/dev/null 2>&1 || true
    fi

    # Without a working incus-agent the guest cannot read the config over 9p,
    # so hand it the seed disk as well. Images from images: ship the agent, but
    # anything built elsewhere may not.
    if [[ "$image" != images:* ]]; then
      incus config device add "$vm_name" cloud-init disk source=cloud-init:config >/dev/null 2>&1 &&
        msg_ok "Attached the cloud-init seed disk" ||
        msg_warn "Could not attach the cloud-init seed disk"
    fi
    msg_ok "Applied cloud-init configuration"
  fi

  set_description

  if [[ "${START_VM:-yes}" == "no" ]]; then
    msg_ok "VM ${vm_name} created but not started"
    _INCUS_VM_CREATED=0 # a deliberately stopped VM is not a failed one
    return 0
  fi

  msg_info "Starting VM ${vm_name}"
  if ! incus start "$vm_name" >/dev/null 2>&1; then
    fatal "Failed to start VM ${vm_name}"
    cleanup_vmid
    return 1
  fi
  msg_ok "Started VM ${vm_name}"

  vm_wait_for_agent "$vm_name" "${VM_AGENT_TIMEOUT:-180}" || true

  local ip
  if ip=$(vm_get_ip "$vm_name"); then
    VM_IP="$ip"
    msg_ok "VM ${vm_name} is reachable at ${BL}${ip}${CL}"
  else
    msg_warn "No IPv4 address yet - check 'incus list ${vm_name}'"
  fi

  _INCUS_VM_CREATED=0 # completed successfully, nothing to roll back
  return 0
}

# ==============================================================================
# SECTION 4: TELEMETRY
# ==============================================================================
# api.func is the shared reporter; the host is the single reporting side.

post_to_api_vm() {
  declare -f post_to_api >/dev/null 2>&1 || return 0
  export TELEMETRY_PLATFORM="incus"
  post_to_api "$@" 2>/dev/null || true
}

post_update_to_api() {
  declare -f post_update_to_api_real >/dev/null 2>&1 && post_update_to_api_real "$@"
  return 0
}

# Kept for parity with the Proxmox entry point; Incus has no numeric IDs and no
# separate storage layout step, so these are intentionally empty.
vm_define_disk_references() { :; }
vm_apply_storage_layout() { :; }
