# Opt-in PVE identity policy. No config is sourced or evaluated.
[[ -n "${_BUILD_UI_IDENTITY_LOADED:-}" ]] && return 0
_BUILD_UI_IDENTITY_LOADED=1

# Capture genuine environment settings before the defaults loader exports values.
_IDENTITY_ENV_KEYS=""
for _identity_key in var_ctid_min var_ctid_max var_mac_template var_net_template var_ipv6_template var_mac var_net var_ipv6_static var_ipv6_method; do
  if printenv "$_identity_key" >/dev/null 2>&1; then
    _IDENTITY_ENV_KEYS+=" $_identity_key"
  fi
done
unset _identity_key

_identity_enabled() {
  [[ -n "${var_ctid_min:-}${var_ctid_max:-}${var_mac_template:-}${var_net_template:-}${var_ipv6_template:-}" ]]
}

_identity_error() {
  msg_error "Container identity: $*" >&2
  return 1
}

_identity_decimal_id() {
  # Canonical decimal only; bound length before shell arithmetic can overflow.
  [[ "$1" =~ ^[1-9][0-9]{2,8}$ ]] && ((10#$1 <= 999999999))
}

_identity_policy() {
  _identity_enabled || return 0
  if [[ "${_INCUS_BUILD_FUNC_LOADED:-}" == "1" || "${LXC_PLATFORM:-}" == incus* ]]; then
    _identity_error "CTID bounds and address templates require Proxmox VE; remove them for Incus."
    return 1
  fi
  local lower="${var_ctid_min:-100}" upper="${var_ctid_max:-999999999}"
  if ! _identity_decimal_id "$lower" || ! _identity_decimal_id "$upper" || ((lower > upper)); then
    _identity_error "use CTID bounds 100..999999999 with min <= max."
    return 1
  fi
}

_identity_assert_id() {
  _identity_enabled || return 0
  _identity_policy || return 1
  local id="$1"
  if ! _identity_decimal_id "$id"; then
    _identity_error "CTID '$id' must be a decimal Proxmox guest ID."
    return 1
  fi
  if [[ -n "${_IDENTITY_BOUND_ID:-}" && "$id" != "$_IDENTITY_BOUND_ID" ]]; then
    _identity_error "templates were rendered for CTID $_IDENTITY_BOUND_ID; CTID changed to $id. Restart with the new ID before creating a guest."
    return 1
  fi
}

_identity_select_id() {
  _identity_policy || return 1
  ensure_dependencies jq >&2 || return 1
  local candidate="${1:-${var_ctid_min:-100}}" upper="${var_ctid_max:-999999999}"
  _identity_decimal_id "$candidate" || {
    _identity_error "invalid CTID candidate '$candidate'."
    return 1
  }
  _identity_assert_id "$candidate" || return 1
  local resources ids
  resources=$(pvesh get /cluster/resources --type vm --output-format json) || {
    _identity_error "cluster resources lookup failed; refusing to guess a free CTID."
    return 1
  }
  ids=$(jq -esr 'if length == 1 then .[0] else error("expected one JSON resource list") end | if type == "array" and all(.[]; (.type == "qemu" or .type == "lxc") and (.vmid | type == "number" and . >= 100 and . <= 999999999 and floor == .)) then [.[].vmid] | unique | map(tostring) | join("\n") else error("invalid cluster guest list") end' <<<"$resources") || {
    _identity_error "invalid cluster resources response; refusing to guess a free CTID."
    return 1
  }
  local -A occupied=()
  local id
  while IFS= read -r id; do
    [[ -n "$id" ]] && occupied["$id"]=1
  done <<<"$ids"
  if [[ "${2:-}" == explicit && -z "${occupied[$candidate]:-}" ]] && validate_container_id "$candidate"; then
    printf '%s\n' "$candidate"
    return 0
  fi
  # Bounds apply to automatic selection, never to an explicit free ID.
  if ((candidate < ${var_ctid_min:-100} || candidate > upper)); then
    candidate="${var_ctid_min:-100}"
  fi
  while ((candidate <= upper)); do
    # Reuse the existing local/pmxcfs/LVM checks as well as the strict snapshot.
    if [[ -z "${occupied[$candidate]:-}" ]] && validate_container_id "$candidate"; then
      _identity_assert_id "$candidate" || return 1
      printf '%s\n' "$candidate"
      return 0
    fi
    candidate=$((candidate + 1))
  done
  _identity_error "no free CTID in the configured range."
}

_identity_template_syntax() {
  local value="$1" token
  [[ "$value" == *'{'* ]] || return 1
  for token in id id_hi id_lo id_hi2 id_lo2; do
    value="${value//\{$token\}/0}"
  done
  [[ "$value" =~ ^[0-9a-fA-F:./]+$ ]]
}

_identity_render() {
  local template="$1" id="$2" kind="$3"
  _identity_decimal_id "$id" && _identity_template_syntax "$template" || return 1
  local hi=$((id / 100)) lo=$((id % 100)) hi2 lo2 rendered="$template"
  if [[ "$template" == *'{id_hi2}'* ]] && ((hi > 99)); then
    _identity_error "{id_hi2} cannot represent CTID $id without truncation."
    return 1
  fi
  # A MAC suffix must encode the whole ID, never only its last two digits.
  if [[ "$kind" == mac && "$template" != *'{id}'* ]]; then
    if [[ "$template" != *'{id_hi}'* && "$template" != *'{id_hi2}'* ]] ||
      [[ "$template" != *'{id_lo}'* && "$template" != *'{id_lo2}'* ]]; then
      _identity_error "MAC templates must include {id} or both high and low ID tokens."
      return 1
    fi
  fi
  printf -v hi2 '%02d' "$hi"
  printf -v lo2 '%02d' "$lo"
  rendered="${rendered//\{id\}/$id}"
  rendered="${rendered//\{id_hi\}/$hi}"
  rendered="${rendered//\{id_lo\}/$lo}"
  rendered="${rendered//\{id_hi2\}/$hi2}"
  rendered="${rendered//\{id_lo2\}/$lo2}"
  if [[ "$rendered" == *'{'* || "$rendered" == *'}'* || ! "$rendered" =~ ^[0-9a-fA-F:./]+$ ]]; then
    _identity_error "unknown token or invalid character in $kind template."
    return 1
  fi
  _identity_validate_address "$kind" "$rendered" || return 1
  printf '%s\n' "$rendered"
}

_identity_validate_address() {
  local kind="$1" rendered="$2"
  case "$kind" in
  mac)
    validate_mac_address "$rendered" || return 1
    local first_octet="${rendered%%:*}"
    (((16#$first_octet & 1) == 0)) && [[ "$rendered" != 00:00:00:00:00:00 ]] || return 1
    ;;
  net)
    # The shared validator uses shell arithmetic: reject octal-looking fields.
    [[ ! "$rendered" =~ (^|[./])0[0-9] ]] && validate_ip_address "$rendered" || return 1
    local cidr="${rendered##*/}" address host_mask host_part
    address=$(ip_to_int "${rendered%/*}")
    if ((cidr <= 30)); then
      host_mask=$(((1 << (32 - cidr)) - 1))
      host_part=$((address & host_mask))
      ((host_part != 0 && host_part != host_mask)) || return 1
    fi
    ;;
  ipv6)
    [[ "$rendered" =~ /[1-9][0-9]{0,2}$ ]] && validate_ipv6_address "$rendered" || return 1
    # The shared validator checks characters/hextet sizes, but not group count.
    local addr="${rendered%%/*}" colons
    [[ "${rendered%/*}" != */* ]] || return 1
    colons="${addr//[^:]/}"
    if [[ "$addr" == *::* ]]; then
      [[ "$addr" != *:::* ]] || return 1
      local segment count=0
      local -a segments
      IFS=: read -r -a segments <<<"$addr"
      for segment in "${segments[@]}"; do
        [[ -n "$segment" ]] && count=$((count + 1))
      done
      ((count < 8)) || return 1
      [[ "$addr" != :* || "$addr" == ::* ]] && [[ "$addr" != *: || "$addr" == *:: ]] || return 1
    else
      ((${#colons} == 7)) && [[ "$addr" != :* && "$addr" != *: ]] || return 1
    fi
    ;;
  *) return 1 ;;
  esac
  return 0
}

_identity_apply_templates() {
  _identity_policy || return 1
  unset _IDENTITY_GENERATED_MAC _IDENTITY_GENERATED_NET _IDENTITY_GENERATED_IPV6
  local field template literal rendered
  for field in mac net ipv6; do
    template="var_${field}_template"
    [[ -n "${!template:-}" ]] || continue
    case "$field" in
    mac) literal="${var_mac:-}" ;;
    net) literal="${var_net:-}" ;;
    ipv6) literal="${var_ipv6_static:-}" ;;
    esac
    _identity_template_syntax "${!template}" || {
      _identity_error "invalid $template"
      return 1
    }
    if [[ -n "$literal" ]]; then
      # A literal replaces the IPv6 template's address, including its implicit
      # static mode. Explicit nonstatic methods continue to take precedence.
      if [[ "$field" == ipv6 && -z "${var_ipv6_method:-}" ]]; then
        IPV6_METHOD=static
      fi
      continue
    fi
    if [[ "$field" == ipv6 && -n "${var_ipv6_method:-}" && "$var_ipv6_method" != static ]]; then
      continue
    fi
    rendered=$(_identity_render "${!template}" "$CT_ID" "$field") || {
      _identity_error "invalid $template for CTID $CT_ID."
      return 1
    }
    case "$field" in
    mac)
      MAC="$rendered"
      _IDENTITY_GENERATED_MAC="$rendered"
      ;;
    net)
      NET="$rendered"
      _IDENTITY_GENERATED_NET="$rendered"
      ;;
    ipv6)
      IPV6_METHOD=static
      IPV6_ADDR="$rendered"
      IPV6_STATIC="$rendered"
      _IDENTITY_GENERATED_IPV6="$rendered"
      ;;
    esac
    _IDENTITY_BOUND_ID="$CT_ID"
  done
}
